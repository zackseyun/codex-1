#!/usr/bin/env bash
set -euo pipefail

REPO="/Users/zackseyun/Documents/GitHub/openai-codex"
UI_DIR="$REPO/codex-js-renderer"
BACKEND_BIN="${CODEX_FORK_BACKEND_BIN:-$REPO/codex-rs/target/debug/codex}"

export CODEX_FORK_UI_LAUNCH_CWD="${PWD}"
export CODEX_FORK_BACKEND_BIN="$BACKEND_BIN"

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  cat <<'EOF'
codex-fork-ui — JavaScript terminal renderer for codex-fork

Usage:
  codex-fork-ui [options] [prompt]

Options:
  -h, --help           Show this help
  -C, --cwd <dir>      Start in a specific working directory
  -m, --model <model>  Override model
  --last               Resume the most recent thread (prefers current cwd)
  --resume <threadId>  Resume a specific thread id
  --list               List recent sessions and exit

Slash commands (inside the UI):
  /resume              List recent sessions (pick one to resume)
  /resume <id>         Resume a specific session
  /new                 Start a fresh session
  /diff                Show git diff
  /compact             Compact context (save tokens)
  /status              Show session info
  /copy                Copy last response to clipboard
  /clear               Clear the feed
  /logout              Log out and quit
  /quit                Exit
  /help                Show all commands

Keyboard shortcuts:
  Ctrl+U / Ctrl+D      Scroll feed up / down
  Ctrl+G               Jump to bottom of feed
  Ctrl+C               Quit
  Enter                Submit prompt (or steer active turn)
  Esc                  Clear input

Examples:
  codex-fork-ui
  codex-fork-ui "summarize this repo"
  codex-fork-ui --last
  codex-fork-ui --list
  codex-fork-ui --resume thread_abc123
  codex-fork-ui -C /path/to/repo --last
EOF
  exit 0
fi

if [[ ! -x "$BACKEND_BIN" ]]; then
  (
    cd "$REPO/codex-rs"
    cargo build -p codex-cli >/dev/null
  )
fi

if [[ ! -d "$UI_DIR/node_modules" ]]; then
  (
    cd "$REPO"
    pnpm install --filter codex-js-renderer >/dev/null
  )
fi

exec pnpm --dir "$UI_DIR" exec tsx src/index.tsx "$@"
